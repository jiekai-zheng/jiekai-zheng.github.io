---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1> Hello, I'm Jiekai. </h1>
			<p>
				A CS student exploring how things work, and writing down what I learn along the way.
			</p>
		</main>
		<Footer />
	</body>
</html>
